{
  // Solo cubre packages/*: es código agnóstico del entorno, así que se puede
  // comprobar desde la raíz con `bunx tsc --noEmit`.
  //
  // Las apps NO se incluyen aquí a propósito: api compila contra los tipos de
  // Bun (sin DOM) y admin contra los del navegador, y además cada una fija su
  // propia versión de TypeScript. `bun run typecheck` en la raíz delega en el
  // script `typecheck` de cada workspace, que usa su tsconfig y su tsc.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["packages/*/src"]
}
