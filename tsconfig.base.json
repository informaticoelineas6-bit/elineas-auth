{
  // Ajustes de TypeScript comunes a todo el monorepo. Cada workspace lo
  // extiende y añade SOLO lo propio de su entorno (`lib`/`types`/`paths`),
  // porque api corre en Bun sin DOM y admin en el navegador: un único tsconfig
  // para ambos obligaría a aflojar la comprobación en los dos.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    // Bun y Vite resuelven la extensión .ts nativamente, así que se permite
    // importarla explícitamente (packages/* la usa).
    "allowImportingTsExtensions": true,

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "exclude": ["node_modules", "dist", ".output", ".nitro"]
}
